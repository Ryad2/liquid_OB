{
  "name": "@liquid-ob/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-abis.mjs",
    "generate:check": "node scripts/generate-abis.mjs --check",
    "wallets:testnet": "node scripts/create-testnet-wallets.mjs",
    "wallets:fund-testnet": "node scripts/fund-testnet-wallets.mjs",
    "wallets:approve-testnet": "node scripts/approve-testnet-executor.mjs",
    "lint": "oxlint src scripts",
    "manifest": "node scripts/create-manifest.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
