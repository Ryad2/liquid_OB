{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @liquid-ob/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/solver",
      "destination": "/api/solver-handler?__solver_path="
    },
    {
      "source": "/api/solver/:__solver_path*",
      "destination": "/api/solver-handler"
    }
  ],
  "functions": {
    "api/solver-handler.ts": {
      "maxDuration": 60,
      "includeFiles": "{services/solver-api/node_modules/@liquid-ob/**,packages/contracts/**,packages/curve-math/**,packages/frontend-api/**,packages/solver-core/**,deployments/84532.json}"
    },
    "api/mcp/[route].ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
