# Optional second Graph-backed source. Snapshot-only is always honest. Enable
# constant-product-v2 only for a compatible two-token pool schema.
STANDARD_DEX_SUBGRAPH_URL=https://gateway.thegraph.com/api/YOUR_KEY/subgraphs/id/YOUR_ID
STANDARD_DEX_VENUE=Example V2 standardized Subgraph
STANDARD_DEX_MODEL=snapshot-only
STANDARD_DEX_FEE_BPS=30
