LIQUIDITY_MCP_TRANSPORT=http
LIQUIDITY_MCP_HOST=0.0.0.0
LIQUIDITY_MCP_PORT=3880
LIQUIDITY_MCP_ALLOWED_ORIGINS=https://your-agent-client.example
LIQUID_OB_API_URL=https://your-solver-api.example
