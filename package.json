{
  "name": "liquid-ob",
  "version": "0.0.0",
  "private": true,
  "description": "A functional order book for bounded, executable maker curves.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @liquid-ob/web dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "contracts:build": "forge build --root contracts",
    "contracts:generate": "forge build --root contracts && node packages/contracts/scripts/generate-abis.mjs",
    "contracts:generate:check": "node packages/contracts/scripts/generate-abis.mjs --check",
    "contracts:fmt": "forge fmt --root contracts --check",
    "contracts:lint": "forge lint --root contracts",
    "contracts:test": "forge test --root contracts --force",
    "wallets:testnet": "pnpm --filter @liquid-ob/contracts wallets:testnet",
    "wallets:fund-testnet": "pnpm --filter @liquid-ob/contracts wallets:fund-testnet",
    "wallets:approve-testnet": "pnpm --filter @liquid-ob/contracts wallets:approve-testnet",
    "deployment:manifest": "pnpm --filter @liquid-ob/contracts manifest",
    "subgraph:codegen": "pnpm --filter @liquid-ob/subgraph codegen",
    "subgraph:build": "pnpm --filter @liquid-ob/subgraph build",
    "reference:generate": "python3 -m tools.reference.generate_vectors",
    "reference:check": "python3 -m tools.reference.generate_vectors --check",
    "reference:test": "python3 -m unittest tools.reference.test_reference_math -v",
    "release:verify": "node scripts/verify-public-demo.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
